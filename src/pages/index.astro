---
import Layout from "../layouts/Layout.astro";
import { features } from '../data/features.ts';
---

<Layout
  title="Home | AstroStarter"
  description="An example Astro homepage built with Tailwind CSS."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(139,92,246,0.15),transparent_60%)]"
    ></div>

    <div class="relative mx-auto max-w-6xl px-6 py-28 text-center">
      <span
        class="inline-flex rounded-full border border-violet-400/30 bg-violet-400/10 px-4 py-2 text-sm font-medium text-violet-300"
      >
        Built with Astro + Tailwind CSS
      </span>

      <h1
        class="mx-auto mt-8 max-w-3xl text-5xl font-extrabold tracking-tight text-white sm:text-7xl"
      >
        Build something
        <span class="text-violet-400"> amazing.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-400">
        A clean, modern Astro starter page styled entirely with
        Tailwind CSS. Simple, responsive, and ready to customize.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="https://docs.astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-violet-600 px-6 py-3 font-semibold text-white transition hover:bg-violet-500"
        >
          Get Started →
        </a>

        <a
          href="#features"
          class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white transition hover:bg-white/10"
        >
          Explore Features
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="border-t border-white/10 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-12 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Everything you need
        </h2>

        <p class="mt-4 text-slate-400">
          A simple foundation for your next project.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {features.map((feature) => (
          <article
            class="rounded-2xl border border-white/10 bg-white/5 p-8 transition hover:border-violet-400/40 hover:bg-white/10"
          >
            <div class="mb-6 text-4xl">{feature.icon}</div>

            <h3 class="mb-3 text-xl font-semibold text-white">
              {feature.title}
            </h3>

            <p class="leading-7 text-slate-400">
              {feature.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
